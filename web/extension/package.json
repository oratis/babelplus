{
  "name": "@babelplus/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "浏览器扩展（MV3，Chrome / Edge）：PAC 候选串 + HTTPS 代理入站，与用户面板共用账号与配额。构建物 dist/ 即商店提交的解包目录。",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@babelplus/shared": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/chrome": "0.2.8",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
