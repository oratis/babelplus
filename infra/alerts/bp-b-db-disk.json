{
  "displayName": "bp-b-db-disk",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "disk utilization >= 80% for 30m",
      "conditionThreshold": {
        "filter": "metric.type=\"cloudsql.googleapis.com/database/disk/utilization\" AND resource.type=\"cloudsql_database\" AND resource.labels.database_id=\"oratis-491316:bp-db\"",
        "aggregations": [
          { "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_MEAN", "crossSeriesReducer": "REDUCE_MAX" }
        ],
        "comparison": "COMPARISON_GE",
        "thresholdValue": 0.8,
        "duration": "1800s",
        "trigger": { "count": 1 }
      }
    }
  ],
  "notificationChannels": [ "" ],
  "alertStrategy": { "autoClose": "86400s" },
  "documentation": { "content": "B 级慢变量，24 小时 autoClose。10 GB SSD 使用率 >= 80%。几十用户的数据量在可预见期内不该接近它，触发即意味着有东西在意料之外地长（日志表、审计表、备份留在实例里）。处置：https://github.com/oratis/babelplus/blob/master/docs/05-adr/0005-database-selection.md §6.3", "mimeType": "text/markdown" }
}
