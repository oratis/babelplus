{
  "displayName": "bp-b-cert-expiring-or-unreachable",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "cert expiring soon (< 14d) > 0 in 5m",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/bp_cert_expiring_soon\" AND resource.type=\"global\"",
        "aggregations": [ { "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM" } ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "0s",
        "trigger": { "count": 1 }
      }
    },
    {
      "displayName": "cert check failed (handshake / no cert) > 0 in 5m",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/bp_cert_check_failed\" AND resource.type=\"global\"",
        "aggregations": [ { "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM" } ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "0s",
        "trigger": { "count": 1 }
      }
    }
  ],
  "notificationChannels": [ "projects/oratis-491316/notificationChannels/13580442405370640559" ],
  "alertStrategy": { "autoClose": "86400s" },
  "documentation": { "content": "B 级。证书剩余有效期 < 14 天（cert_expiring_soon），或对某个域名 TLS 握手失败 / 取不到证书（cert_check_failed）。前者是续签窗口：在到期前跑 ./infra/scripts/renew-le-cert.sh --apply（LE 90 天，剩 < 30 天 certbot 才真续）。后者可能是域名整个连不上 —— 先从别的网络 curl 一次再判断。处置：https://github.com/oratis/babelplus/blob/master/docs/04-ops/monitoring.md §8", "mimeType": "text/markdown" }
}
