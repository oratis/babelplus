# bp-api 环境变量样例
#
# 复制成 .env 后填值。**.env 已被 gitignore，绝不要提交真实凭据。**
# 生产环境的值来自 Secret Manager（bp- 前缀），由 deploy-api.sh 挂载，不走本文件。
#
# 缺少任何一个必需变量，进程会**拒绝启动**并列出缺了哪些（config 包的 fail-closed）。

# ---- 必需 ----

# 运行环境：dev | staging | prod
BP_ENV=dev

# Postgres 连接串。
#   本地开发（make pg-up 起的库）：
BP_DATABASE_URL=postgres://postgres:devpass@127.0.0.1:55433/babelplus?sslmode=disable
#   Cloud Run 上走内建 Cloud SQL 连接器的 Unix socket（ADR 0005，不建 VPC connector）：
#   BP_DATABASE_URL=postgres://bp_app:<密码>@/bp?host=/cloudsql/oratis-491316:us-central1:bp-db
#
#   实例名 bp-db / 库名 bp / 角色名 bp_app 的事实源是 infra/deploy/setup-infra.sh
#   里的 SQL_INSTANCE / SQL_DATABASE / SQL_USER 三个常量（与 deploy.md §3.4、ADR 0005 §10.2 一致）。
#   注意角色名用下划线 bp_app 而不是 bp-app：带连字符的 Postgres 角色名在每条 SQL 里都要加引号。
#   生产上这一整串（含密码）作为 secret `bp-database-url` 注入，不在这里填。

# 订阅 token 哈希的 pepper。泄漏等于所有订阅可被离线爆破。
# 生成：openssl rand -base64 48
BP_SUBSCRIPTION_TOKEN_PEPPER=

# 节点密钥哈希的 pepper。与订阅分开，避免一处泄漏波及两个面。
BP_NODE_KEY_PEPPER=

# 用户会话签名密钥。
BP_SESSION_SIGNING_KEY=

# GCP 项目 ID。prod 环境会校验必须是 oratis-491316。
BP_GCP_PROJECT_ID=oratis-491316

# ---- 可选（有默认值）----

# 监听端口。Cloud Run 会注入 PORT，本地默认 8080。
# PORT=8080

# 每实例数据库连接池上限，默认 2。
#
# 🔴 不要随手调大。ADR 0005 选的 db-f1-micro 可用连接数很少，
#    而 Cloud Run 会横向扩容。max-instances=8 × 每实例 2 = 峰值 16 连接。
#    改这个值必须同步改 infra/deploy/deploy-api.sh 的 --max-instances，两者是一对。
# BP_DB_MAX_CONNS=2

# 日志级别：debug | info | warn | error
# BP_LOG_LEVEL=info

# 是否信任 X-Forwarded-For。
#
# 来源 IP 会写进 subscription_fetch_log 用于识别账号共享 ——
# 在不可信环境下信任 XFF 等于让用户自己决定日志里记什么。
# 默认：dev 为 false，其余为 true（Cloud Run 前面有 Google 前端，可信）。
# BP_TRUST_PROXY_HEADERS=false

# ---- 内部面：/internal/tasks/* 的 Google OIDC（api-contract §7）----
#
# 两项**必须同时配置或同时留空**（config.Load 会强制这一点）。
# 留空 = 整条内部面拒绝（fail-closed），六条 Cloud Scheduler 与一条 Cloud Tasks
# 队列全部拿 403 —— 本地开发不需要它们，所以留空是正常的。

# ID token 的 aud，必须逐字节等于创建 Scheduler / Tasks 时填的 --oidc-token-audience。
#
# 🔴 取值是 **Cloud Run 服务的默认 URL**（https://bp-api-xxxxxxxx.a.run.app），
#    不是镜像域名、也不是 API 主域名：镜像域名会轮换，而 aud 换一次
#    就要重建全部六条 Scheduler 与队列，漏掉哪一条只表现为「那个任务安静地不再运行」。
# BP_INTERNAL_OIDC_AUDIENCE=

# 允许调用 /internal/tasks/* 的服务账号 email 白名单（逗号分隔）。
# 不接受 `*` / `all` —— 放开它等于把九个任务端点开放给任何持有合法 Google ID token 的人。
# BP_INTERNAL_TASK_CALLERS=bp-scheduler@oratis-491316.iam.gserviceaccount.com

# ---- 管理面：IAP 断言 + TOTP step-up（api-contract §6）----
#
# 同样**必须同时配置或同时留空**。留空 = 管理面整体拒绝。
#
# 🔴 留空必须是「进不去」而不是「谁都进得去」：`x-goog-iap-jwt-assertion`
#    在没有 IAP 的部署形态下是任何人都能设的普通请求头。

# IAP 断言的 aud：/projects/<PROJECT_NUMBER>/global/backendServices/<BACKEND_SERVICE_ID>
# 两段都是**数字 ID**（项目编号不是项目 ID；后端服务的 id 不是名字）：
#   gcloud compute backend-services describe <NAME> --global --format='value(id)'
# BP_ADMIN_IAP_AUDIENCE=

# 解密 admin_users.totp_secret_enc 的 AES-256 密钥，base64 形态，解码后必须是 32 字节。
# 生成：openssl rand -base64 32
# 生产上作为 secret 注入，不在这里填。
# BP_ADMIN_TOTP_ENC_KEY=
